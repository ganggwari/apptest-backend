# ---------------------------------------------------------------
# 사용 방법
# 1. 이 파일을 복사해서 application-secret.properties 로 이름을 바꾸세요.
#    (같은 폴더: src/main/resources)
# 2. 복사본에 실제 값을 채우세요. 이 .example 파일에는 진짜 키를 넣지 마세요.
# 3. application-secret.properties 는 .gitignore 로 Git에 올라가지 않습니다. 절대 커밋하지 마세요.
# 아래 DB·OCR 값은 로컬 개발용 기본값이고, 키 항목은 직접 발급받은 값으로 바꿔야 합니다.
# ---------------------------------------------------------------

# ---- 데이터베이스 (필수) ----
secret.db.url=jdbc:postgresql://localhost:5432/mydb?stringtype=unspecified
secret.db.username=postgres
secret.db.password=여기에_DB_비밀번호

# ---- 내부 API 키 (필수) ----
# FastAPI 가 X-Internal-Api-Key 헤더로 보냅니다. 양쪽이 같은 값을 써야 합니다.
secret.internal.api-key=여기에_임의의_긴_문자열

# ---- OCR 서버 주소 (필수) ----
secret.ocr-server.url=http://localhost:8000

# ---- 기상청 날씨 API 키, data.go.kr (프런트 날씨 화면을 실제 날씨로 보여줄 때) ----
# 반드시 "Decoding" 키를 넣으세요. "Encoding" 키가 아닙니다.
# 이 키로 받은 실제 날씨는 서버 메모리에만 두고 날씨 화면(/api/weather)에만 씁니다.
# 침수 예측 모델(FastAPI)이 읽는 날씨는 이 키와 상관없이 기존 stub 값 그대로입니다.
# 비워 두면 호출하지 않고 날씨 화면에 "미수신"으로 나옵니다.
secret.kma.service-key=여기에_기상청_Decoding_키

# ---- 신월여의지하도로 공개 CCTV (서울터널) ----
# 키가 필요 없습니다. 서버가 공개 주소(seoultunnel.co.kr)를 대신 호출하므로 넣을 값이 없습니다.

# ---- 카카오 (내비게이션 기능을 쓸 때) ----
# REST 키: 서버가 길찾기·장소검색을 호출할 때 씁니다. 프런트에 절대 내려주지 않습니다.
# 팀원마다 카카오 개발자 콘솔에서 각자 발급받아 자기 로컬 파일에만 넣으세요.
secret.kakao.rest-key=여기에_카카오_REST_키
# JavaScript 키: 내비 PWA 의 지도에 쓰는 키입니다. 콘솔의 [플랫폼 > Web] 에
# 사용할 도메인(http://localhost:5173, PWA 터널 주소 등)을 등록해야 동작합니다.
secret.kakao.js-key=여기에_카카오_JavaScript_키

secret.gemini.api-key=

# ---- 푸시 알림 FCM (puf.fcm.enabled=true 로 켤 때만) ----
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성" 으로 받은 JSON 파일의 경로입니다.
# 이 JSON 파일은 비밀키가 들어 있으니 프로젝트 폴더 밖(예: C:/keys/puf-fcm.json)에 두고 Git 에 올리지 마세요.
# 비워 두면(또는 puf.fcm.enabled=false 면) 실제로 보내지 않고 서버 로그에만 남깁니다.
secret.fcm.credentials-path=

# ---- 나중에 (아직 쓰지 않음) ----
# 인증 문자는 지금 StubSmsSender(콘솔 출력)라 넣을 값이 없습니다. 실제 문자 서비스를 붙이면 아래 키를 씁니다.
# secret.sms.api-key=
